# Leave blank to use automatic mock mode.
OPENAI_API_KEY=

# Used only when OPENAI_API_KEY is present and MOCK_MODE is false.
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30

# Primary hackathon-demo mode: deterministic and independent of Wi-Fi/API health.
# Set false only when intentionally testing real OpenAI narration.
MOCK_MODE=true

# URL used by the Streamlit server to reach FastAPI.
CONTROL_TOWER_API_URL=http://127.0.0.1:8000
BACKEND_REQUEST_TIMEOUT_SECONDS=90

# Control Tower baseline and detector defaults. Keep these aligned across demos.
BASELINE_MINIMUM_VOLUME=50
DETECTOR_MINIMUM_VOLUME=50
DETECTOR_ABSOLUTE_DROP=0.08
DETECTOR_Z_SCORE_THRESHOLD=-3
DETECTOR_CONSECUTIVE_WINDOWS=2
LIVE_WINDOW_MINUTES=5

# Optional Telegram incident delivery. Leave disabled unless a local bot/chat is configured.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram buttons require a public HTTPS URL. Leave blank for a local-only demo.
TELEGRAM_DASHBOARD_URL=

# Optional durable local SQLite paths. Defaults are system-temp SQLite files.
# INCIDENT_MEMORY_DB=./data/incident-memory.sqlite3
# REMEDIATION_AUDIT_DB=./data/remediation-audit.sqlite3
