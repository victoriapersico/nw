# Leave blank to use automatic mock mode.
OPENAI_API_KEY=

# Used only when OPENAI_API_KEY is present and MOCK_MODE is false.
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30

# Set true to force mock mode even when an API key is configured.
MOCK_MODE=false

# URL used by the Streamlit server to reach FastAPI.
BACKEND_URL=http://localhost:8000
BACKEND_REQUEST_TIMEOUT_SECONDS=90

# Control Tower baseline and detector defaults. Keep these aligned across demos.
BASELINE_MINIMUM_VOLUME=50
DETECTOR_MINIMUM_VOLUME=50
DETECTOR_ABSOLUTE_DROP=0.08
DETECTOR_Z_SCORE_THRESHOLD=-3
DETECTOR_CONSECUTIVE_WINDOWS=2
LIVE_WINDOW_MINUTES=5
